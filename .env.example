# Strucvre Web — Next.js + Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[SEU-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[SUA-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[SUA-SERVICE-ROLE-KEY]

# Banco Prisma (use connection string do Supabase pooler)
DATABASE_URL=postgresql://postgres:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres

# Integração com API Flask existente (opcional — se quiser manter o backend antigo como fallback)
LEGACY_API_URL=http://localhost:8001

# Webhook do Hermes para notificação silenciosa de leads
HERMES_WEBHOOK_URL=

# IDs de afiliado (coloque os reais em .env.local — NÃO commitar)
# Usados por lib/affiliate.ts para derivar o link em runtime.
AFFILIATE_AMAZON_TAG=seutag-20
AFFILIATE_SHOPEE_ID=
AFFILIATE_ML_AWIN_ID=
AFFILIATE_ALIEXPRESS_ID=
